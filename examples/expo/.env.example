# Copy to .env.local to override. All are optional.
# Defaults: http://127.0.0.1:4010 (iOS) and http://10.0.2.2:4010 (Android emulator).
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4010
# 1 = Retina test build: renders retina-ready-* and retina-build-id markers and
# accepts ?run=<id> on deep links. Leave unset (or 0) for production builds.
EXPO_PUBLIC_RETINA_TEST_MODE=0
# Only used in test mode, as the retina-build-id text.
EXPO_PUBLIC_BUILD_ID=dev
