# Copy to .env.local to override. All are optional.
VITE_API_BASE_URL=http://127.0.0.1:4010
# 1 = Retina test build: adds data-retina-ready, <meta name="retina-build-id">
# and ?retinaRun=<id> support. Leave unset (or 0) for production builds.
VITE_RETINA_TEST_MODE=0
# Only used in test mode, as the retina-build-id meta content.
VITE_BUILD_ID=dev
