{
  // Node-side Retina scenario code (runs in Vitest, not in the browser).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.retina.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "customConditions": ["retina-source"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["retina/**/*.ts"]
}
